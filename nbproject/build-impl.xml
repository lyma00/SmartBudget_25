<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:j2seproject1="http://www.netbeans.org/ns/j2se-project/1"
         xmlns:j2seproject3="http://www.netbeans.org/ns/j2se-project/3"
         xmlns:jaxrpc="http://www.netbeans.org/ns/jax-rpc"
         basedir=".."
         default="default"
         name="SmartBudget-impl">

    <property file="nbproject/private/private.properties"/>
    <property file="nbproject/project.properties"/>

    <target name="default" depends="test,jar" description="Build and test whole project."/>

    <target name="-pre-init"/>
    <target name="-init-private"/>
    <target name="-init-user"/>
    <target name="-init-project"/>
    <target name="-do-init"/>
    <target name="-post-init"/>
    <target name="-init-check">
        <fail unless="src.dir">Must set src.dir</fail>
        <fail unless="test.src.dir">Must set test.src.dir</fail>
        <fail unless="build.dir">Must set build.dir</fail>
        <fail unless="dist.dir">Must set dist.dir</fail>
        <fail unless="dist.javadoc.dir">Must set dist.javadoc.dir</fail>
        <fail unless="build.classes.dir">Must set build.classes.dir</fail>
        <fail unless="dist.jar">Must set dist.jar</fail>
        <fail unless="main.class">Must set main.class</fail>
    </target>

    <target name="-init-macrodef-property">
        <macrodef name="property" uri="http://www.netbeans.org/ns/j2se-project/1">
            <attribute name="name"/>
            <attribute name="value"/>
            <sequential>
                <property name="@{name}" value="@{value}"/>
            </sequential>
        </macrodef>
    </target>

    <target name="-init-macrodef-javac">
        <macrodef name="javac" uri="http://www.netbeans.org/ns/j2se-project/3">
            <attribute default="${src.dir}" name="srcdir"/>
            <attribute default="${build.classes.dir}" name="destdir"/>
            <attribute default="${javac.classpath}" name="classpath"/>
            <attribute default="${javac.processorpath}" name="processorpath"/>
            <attribute default="${build.generated.sources.dir}/ap-source-output" name="apgeneratedsrcdir"/>
            <attribute default="${includes}" name="includes"/>
            <attribute default="${excludes}" name="excludes"/>
            <attribute default="${javac.debug}" name="debug"/>
            <attribute default="${empty.dir}" name="sourcepath"/>
            <attribute default="${empty.dir}" name="gensrcdir"/>
            <element name="customize" optional="true"/>
            <sequential>
                <property location="${build.dir}/empty" name="empty.dir"/>
                <mkdir dir="${empty.dir}"/>
                <mkdir dir="@{apgeneratedsrcdir}"/>
                <javac debug="@{debug}"
                       deprecation="${javac.deprecation}"
                       destdir="@{destdir}"
                       encoding="${source.encoding}"
                       excludes="@{excludes}"
                       includeantruntime="false"
                       includes="@{includes}"
                       source="${javac.source}"
                       sourcepath="@{sourcepath}"
                       srcdir="@{srcdir}"
                       target="${javac.target}"
                       classpath="@{classpath}">
                    <customize/>
                </javac>
            </sequential>
        </macrodef>
    </target>

    <target name="-init-macrodef-junit"/>
    <target name="-init-macrodef-testng"/>
    <target name="-init-macrodef-test-impl"/>
    <target name="-init-macrodef-junit-init"/>
    <target name="-init-macrodef-test"/>
    <target name="-init-macrodef-junit-single"/>
    <target name="-init-macrodef-test-single"/>
    <target name="-init-macrodef-junit-single-method"/>
    <target name="-init-macrodef-test-single-method"/>

    <target depends="-pre-init,-init-private,-init-user,-init-project,-do-init,-post-init,-init-check,-init-macrodef-property,-init-macrodef-javac,-init-macrodef-junit,-init-macrodef-testng,-init-macrodef-test-impl,-init-macrodef-junit-init,-init-macrodef-test,-init-macrodef-junit-single,-init-macrodef-test-single,-init-macrodef-junit-single-method,-init-macrodef-test-single-method"
             name="init"/>

    <target name="-deps-jar-init" unless="built-jar.properties"/>
    <target name="-init-dep-module-jars"/>
    <target name="-deps-jar" depends="-deps-jar-init"/>

    <target name="-pre-pre-compile"/>
    <target name="-pre-compile"/>
    <target name="-copy-persistence-xml"/>

    <target name="-do-compile" depends="init,-deps-jar">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${build.generated.sources.dir}/ap-source-output"/>
        <javac debug="true"
               deprecation="${javac.deprecation}"
               destdir="${build.classes.dir}"
               encoding="${source.encoding}"
               excludes="${excludes}"
               includeantruntime="false"
               includes="${includes}"
               source="${javac.source}"
               srcdir="${src.dir}"
               target="${javac.target}"
               classpath="${javac.classpath}"/>
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}" excludes="${build.classes.excludes},${excludes}"/>
        </copy>
    </target>

    <target name="-post-compile"/>
    <target name="compile" depends="init,-pre-pre-compile,-pre-compile,-do-compile,-post-compile"
            description="Compile project."/>

    <target name="-pre-compile-single"/>
    <target name="-do-compile-single" depends="init,-deps-jar,-pre-compile-single">
        <fail unless="javac.includes">Must select some files in the IDE or set javac.includes</fail>
        <mkdir dir="${build.classes.dir}"/>
        <javac debug="true"
               deprecation="${javac.deprecation}"
               destdir="${build.classes.dir}"
               encoding="${source.encoding}"
               excludes="${excludes}"
               includeantruntime="false"
               includes="${javac.includes}"
               source="${javac.source}"
               srcdir="${src.dir}"
               target="${javac.target}"
               classpath="${javac.classpath}"/>
    </target>
    <target name="-post-compile-single"/>
    <target name="compile-single" depends="init,-pre-compile-single,-do-compile-single,-post-compile-single"/>

    <target name="-pre-jar"/>
    <target name="-do-jar-without-manifest" depends="init,compile,-pre-jar" unless="manifest.available-and-main">
        <mkdir dir="${dist.dir}"/>
        <jar compress="${jar.compress}" jarfile="${dist.jar}">
            <fileset dir="${build.classes.dir}"/>
        </jar>
    </target>

    <target name="-do-jar-with-manifest" depends="init,compile,-pre-jar" if="manifest.available">
        <mkdir dir="${dist.dir}"/>
        <jar compress="${jar.compress}" jarfile="${dist.jar}" manifest="${manifest.file}">
            <fileset dir="${build.classes.dir}"/>
        </jar>
    </target>

    <target name="-do-jar-with-mainclass" depends="init,compile,-pre-jar" if="manifest.available-and-main">
        <mkdir dir="${dist.dir}"/>
        <jar compress="${jar.compress}" jarfile="${dist.jar}">
            <fileset dir="${build.classes.dir}"/>
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="-check-manifest">
        <condition property="manifest.available">
            <and>
                <isset property="manifest.file"/>
                <available file="${manifest.file}"/>
            </and>
        </condition>
        <condition property="manifest.available-and-main">
            <and>
                <isset property="manifest.file"/>
                <available file="${manifest.file}"/>
                <isset property="main.class"/>
                <not>
                    <equals arg1="${main.class}" arg2="" trim="true"/>
                </not>
            </and>
        </condition>
    </target>

    <target name="-post-jar"/>
    <target name="jar" depends="init,compile,-pre-jar,-check-manifest,-do-jar-with-mainclass,-do-jar-with-manifest,-do-jar-without-manifest,-post-jar"
            description="Build JAR."/>

    <target name="-pre-run"/>
    <target name="-do-run" depends="init,compile">
        <java classname="${main.class}" fork="true">
            <classpath>
                <pathelement path="${run.classpath}"/>
            </classpath>
            <jvmarg line="${run.jvmargs}"/>
        </java>
    </target>
    <target name="-post-run"/>
    <target name="run" depends="init,compile,-pre-run,-do-run,-post-run" description="Run project."/>

    <target name="-pre-debug"/>
    <target name="-do-debug" depends="init,compile">
        <java classname="${main.class}" fork="true">
            <classpath>
                <pathelement path="${run.classpath}"/>
            </classpath>
            <jvmarg value="-Xdebug"/>
            <jvmarg value="-Xnoagent"/>
            <jvmarg value="-Djava.compiler=none"/>
            <jvmarg value="-Xrunjdwp:transport=dt_socket,address=${jpda.address},server=y,suspend=y"/>
            <jvmarg line="${run.jvmargs}"/>
        </java>
    </target>
    <target name="-post-debug"/>
    <target name="debug" depends="init,compile,-pre-debug,-do-debug,-post-debug" description="Debug project."/>

    <target name="test" depends="compile" description="Run tests (none configured)."/>

    <target name="clean" depends="init" description="Clean build products.">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="javadoc" depends="init" description="Build Javadoc.">
        <mkdir dir="${dist.javadoc.dir}"/>
        <javadoc destdir="${dist.javadoc.dir}"
                 source="${javac.source}"
                 notree="${javadoc.notree}"
                 use="${javadoc.use}"
                 nonavbar="${javadoc.nonavbar}"
                 noindex="${javadoc.noindex}"
                 splitindex="${javadoc.splitindex}"
                 author="${javadoc.author}"
                 version="${javadoc.version}"
                 windowtitle="${javadoc.windowtitle}"
                 private="${javadoc.private}"
                 additionalparam="${javadoc.additionalparam}"
                 failonerror="true"
                 useexternalfile="true"
                 encoding="${source.encoding}">
            <classpath>
                <pathelement path="${javac.classpath}"/>
            </classpath>
            <fileset dir="${src.dir}" includes="**/*.java"/>
        </javadoc>
    </target>

</project>
